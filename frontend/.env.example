# ScoutVision frontend environment
# Copy to .env.local for local overrides, or set these in your hosting provider.
#
# Leave both empty when the frontend and backend are served from the same origin
# (Vite dev proxy, or the Docker nginx proxy).
# VITE_API_BASE_URL=http://localhost:8000/api/v1
# VITE_HEALTH_URL=http://localhost:8000/health

# Deployed example:
# VITE_API_BASE_URL=https://scoutvision-api.onrender.com/api/v1
# VITE_HEALTH_URL=https://scoutvision-api.onrender.com/health
